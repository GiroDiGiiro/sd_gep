    <actionsetting icon="" action="import math&#xd;&#xa;import sip&#xd;&#xa;&#xd;&#xa;from PyQt5.QtWidgets import QMessageBox&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject,&#xd;&#xa;    QgsGeometry,&#xd;&#xa;    QgsVariantUtils&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;from qgis.PyQt.QtWidgets import QApplication&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;# --------------------------------------------------&#xd;&#xa;# Fonctions utilitaires&#xd;&#xa;# --------------------------------------------------&#xd;&#xa;&#xd;&#xa;def est_nul(valeur):&#xd;&#xa;    &quot;&quot;&quot;Teste NULL, None et les chaînes vides.&quot;&quot;&quot;&#xd;&#xa;    if valeur is None:&#xd;&#xa;        return True&#xd;&#xa;&#xd;&#xa;    try:&#xd;&#xa;        if QgsVariantUtils.isNull(valeur):&#xd;&#xa;            return True&#xd;&#xa;    except (TypeError, ValueError):&#xd;&#xa;        pass&#xd;&#xa;&#xd;&#xa;    if isinstance(valeur, str) and not valeur.strip():&#xd;&#xa;        return True&#xd;&#xa;&#xd;&#xa;    return False&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;def valeur_numerique(valeur):&#xd;&#xa;    &quot;&quot;&quot;Convertit une valeur en nombre, sinon renvoie None.&quot;&quot;&quot;&#xd;&#xa;    if est_nul(valeur):&#xd;&#xa;        return None&#xd;&#xa;&#xd;&#xa;    try:&#xd;&#xa;        nombre = float(valeur)&#xd;&#xa;        if math.isfinite(nombre):&#xd;&#xa;            return nombre&#xd;&#xa;    except (TypeError, ValueError, OverflowError):&#xd;&#xa;        pass&#xd;&#xa;&#xd;&#xa;    return None&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;def champs_existent(couche, noms):&#xd;&#xa;    &quot;&quot;&quot;Vérifie que tous les champs existent.&quot;&quot;&quot;&#xd;&#xa;    return all(couche.fields().indexFromName(n) >= 0 for n in noms)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;# --------------------------------------------------&#xd;&#xa;# Récupération de la couche et de l'entité&#xd;&#xa;# --------------------------------------------------&#xd;&#xa;parent = QApplication.activeWindow()&#xd;&#xa;layer_id = '[% @layer_id %]'&#xd;&#xa;layer = QgsProject.instance().mapLayer(layer_id)&#xd;&#xa;&#xd;&#xa;fid = [%$id%]&#xd;&#xa;&#xd;&#xa;if layer is None:&#xd;&#xa;    QMessageBox.warning(parent, &quot;Erreur&quot;, &quot;Couche introuvable.&quot;)&#xd;&#xa;&#xd;&#xa;elif not layer.isValid():&#xd;&#xa;    QMessageBox.warning(parent, &quot;Erreur&quot;, &quot;La couche est invalide.&quot;)&#xd;&#xa;&#xd;&#xa;elif not champs_existent(layer, [&#xd;&#xa;    'fe_aval',&#xd;&#xa;    'fe_amont',&#xd;&#xa;    'profondeur_fe_aval',&#xd;&#xa;    'profondeur_fe_amont',&#xd;&#xa;    'regard_aval_id',&#xd;&#xa;    'regard_amont_id',&#xd;&#xa;    'anomalie_lineaire_type_id',&#xd;&#xa;    'pente',&#xd;&#xa;    'have_anomalie'&#xd;&#xa;]):&#xd;&#xa;    QMessageBox.warning(&#xd;&#xa;        parent, &quot;Erreur&quot;,&#xd;&#xa;        &quot;Un ou plusieurs champs nécessaires sont absents.&quot;&#xd;&#xa;    )&#xd;&#xa;&#xd;&#xa;else:&#xd;&#xa;    f = layer.getFeature(fid)&#xd;&#xa;&#xd;&#xa;    if not f.isValid():&#xd;&#xa;        QMessageBox.warning(&#xd;&#xa;            parent, &quot;Erreur&quot;, &quot;Entité introuvable.&quot;&#xd;&#xa;        )&#xd;&#xa;&#xd;&#xa;    else:&#xd;&#xa;        # ------------------------------------------&#xd;&#xa;        # Contrôle des regards et des cotes&#xd;&#xa;        # ------------------------------------------&#xd;&#xa;&#xd;&#xa;        fe_aval = valeur_numerique(f['fe_aval'])&#xd;&#xa;        fe_amont = valeur_numerique(f['fe_amont'])&#xd;&#xa;&#xd;&#xa;        if (fe_aval is None and fe_amont) or (fe_aval and fe_amont is None):&#xd;&#xa;            QMessageBox.warning(&#xd;&#xa;                parent,&#xd;&#xa;                &quot;Regards manquants&quot;,&#xd;&#xa;                &quot;Le réseau doit être relié à deux regards &quot;&#xd;&#xa;            )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        elif fe_aval is None and fe_amont is None:&#xd;&#xa;            QMessageBox.warning(&#xd;&#xa;                parent,&#xd;&#xa;                &quot;Valeurs incorrects&quot;,&#xd;&#xa;                &quot;les champs fe_aval et fe_amont doivent &quot;&#xd;&#xa;                &quot;contenir des valeurs numériques valides.&quot;&#xd;&#xa;            )&#xd;&#xa;&#xd;&#xa;        else:&#xd;&#xa;            # --------------------------------------&#xd;&#xa;            # Contrôle de la géométrie&#xd;&#xa;            # --------------------------------------&#xd;&#xa;&#xd;&#xa;            geom = f.geometry()&#xd;&#xa;&#xd;&#xa;            if geom.isNull() or geom.isEmpty():&#xd;&#xa;                QMessageBox.warning(&#xd;&#xa;                    parent, &quot;Erreur&quot;, &quot;Géométrie vide.&quot;&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;            elif geom.type() != 1:&#xd;&#xa;                QMessageBox.warning(&#xd;&#xa;                    parent,&#xd;&#xa;                    &quot;Erreur&quot;,&#xd;&#xa;                    &quot;La géométrie doit être une ligne.&quot;&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;            else:&#xd;&#xa;                vertices = list(reversed(list(geom.vertices())))&#xd;&#xa;&#xd;&#xa;                if len(vertices) &lt; 2:&#xd;&#xa;                    QMessageBox.warning(&#xd;&#xa;                        parent,&#xd;&#xa;                        &quot;Erreur&quot;,&#xd;&#xa;                        &quot;La ligne doit contenir au moins deux sommets.&quot;&#xd;&#xa;                    )&#xd;&#xa;&#xd;&#xa;                else:&#xd;&#xa;                    new_geom = QgsGeometry.fromPolyline(vertices)&#xd;&#xa;&#xd;&#xa;                    # ----------------------------------&#xd;&#xa;                    # Calcul de la pente&#xd;&#xa;                    # ----------------------------------&#xd;&#xa;&#xd;&#xa;                    dz = fe_aval - fe_amont&#xd;&#xa;&#xd;&#xa;                    dx = vertices[-1].x() - vertices[0].x()&#xd;&#xa;                    dy = vertices[-1].y() - vertices[0].y()&#xd;&#xa;&#xd;&#xa;                    longueur = math.hypot(dx, dy)&#xd;&#xa;&#xd;&#xa;                    if longueur == 0:&#xd;&#xa;                        QMessageBox.warning(&#xd;&#xa;                            parent,&#xd;&#xa;                            &quot;Erreur&quot;,&#xd;&#xa;                            &quot;La longueur horizontale est nulle.&quot;&#xd;&#xa;                        )&#xd;&#xa;&#xd;&#xa;                    else:&#xd;&#xa;                        pente = dz / longueur * 100&#xd;&#xa;&#xd;&#xa;                        # ----------------------------------&#xd;&#xa;                        # Contrôle de la ValueMap&#xd;&#xa;                        # ----------------------------------&#xd;&#xa;&#xd;&#xa;                        idx = layer.fields().lookupField(&#xd;&#xa;                            'anomalie_lineaire_type_id'&#xd;&#xa;                        )&#xd;&#xa;&#xd;&#xa;                        config = layer.editorWidgetSetup(idx).config()&#xd;&#xa;                        raw_map = config.get('map')&#xd;&#xa;&#xd;&#xa;                        value_map = {}&#xd;&#xa;&#xd;&#xa;                        if isinstance(raw_map, list):&#xd;&#xa;                            for element in raw_map:&#xd;&#xa;                                if isinstance(element, dict):&#xd;&#xa;                                    value_map.update(element)&#xd;&#xa;&#xd;&#xa;                        elif isinstance(raw_map, dict):&#xd;&#xa;                            value_map = raw_map&#xd;&#xa;&#xd;&#xa;                        contre_pente_id = value_map.get('contre-pente')&#xd;&#xa;&#xd;&#xa;                        if contre_pente_id is None:&#xd;&#xa;                            QMessageBox.warning(&#xd;&#xa;                                parent,&#xd;&#xa;                                &quot;Erreur&quot;,&#xd;&#xa;                                &quot;La valeur 'contre-pente' est absente &quot;&#xd;&#xa;                                &quot;de la ValueMap du champ &quot;&#xd;&#xa;                                &quot;anomalie_lineaire_type_id.&quot;&#xd;&#xa;                            )&#xd;&#xa;&#xd;&#xa;                        else:&#xd;&#xa;                            # ----------------------------------&#xd;&#xa;                            # Préparation des modifications&#xd;&#xa;                            # ----------------------------------&#xd;&#xa;&#xd;&#xa;                            prof_av = f['profondeur_fe_aval']&#xd;&#xa;                            prof_am = f['profondeur_fe_amont']&#xd;&#xa;&#xd;&#xa;                            noeud_av = f['regard_aval_id']&#xd;&#xa;                            noeud_am = f['regard_amont_id']&#xd;&#xa;&#xd;&#xa;                            # Échange des regards&#xd;&#xa;                            f['regard_aval_id'] = noeud_am&#xd;&#xa;                            f['regard_amont_id'] = noeud_av&#xd;&#xa;&#xd;&#xa;                            # Échange des profondeurs&#xd;&#xa;                            f['profondeur_fe_aval'] = prof_am&#xd;&#xa;                            f['profondeur_fe_amont'] = prof_av&#xd;&#xa;&#xd;&#xa;                            # Mise à jour de la pente&#xd;&#xa;                            f['pente'] = pente&#xd;&#xa;                            f['have_anomalie'] = pente > 0&#xd;&#xa;&#xd;&#xa;                            if pente > 0:&#xd;&#xa;                                f['anomalie_lineaire_type_id'] = (&#xd;&#xa;                                    contre_pente_id&#xd;&#xa;                                )&#xd;&#xa;&#xd;&#xa;                            # ----------------------------------&#xd;&#xa;                            # Écriture dans la couche&#xd;&#xa;                            # ----------------------------------&#xd;&#xa;&#xd;&#xa;                            deja_en_edition = layer.isEditable()&#xd;&#xa;&#xd;&#xa;                            if not deja_en_edition:&#xd;&#xa;                                if not layer.startEditing():&#xd;&#xa;                                    QMessageBox.warning(&#xd;&#xa;                                        parent,&#xd;&#xa;                                        &quot;Erreur&quot;,&#xd;&#xa;                                        &quot;Impossible de démarrer l'édition.&quot;&#xd;&#xa;                                    )&#xd;&#xa;&#xd;&#xa;                            if layer.isEditable():&#xd;&#xa;                                ok_attributs = layer.updateFeature(f)&#xd;&#xa;                                ok_geometrie = (&#xd;&#xa;                                    layer.changeGeometry(fid, new_geom)&#xd;&#xa;                                    if ok_attributs&#xd;&#xa;                                    else False&#xd;&#xa;                                )&#xd;&#xa;&#xd;&#xa;                                if not ok_attributs or not ok_geometrie:&#xd;&#xa;                                    QMessageBox.warning(&#xd;&#xa;                                        parent,&#xd;&#xa;                                        &quot;Erreur&quot;,&#xd;&#xa;                                        &quot;La modification a échoué. &quot;&#xd;&#xa;                                        &quot;Vérifie les erreurs de la couche.&quot;&#xd;&#xa;                                    )&#xd;&#xa;&#xd;&#xa;                                else:&#xd;&#xa;                                    # Rafraîchissement du formulaire&#xd;&#xa;                                    if (&#xd;&#xa;                                        'form' in globals()&#xd;&#xa;                                        and not sip.isdeleted(form)&#xd;&#xa;                                    ):&#xd;&#xa;                                        form.setFeature(&#xd;&#xa;                                            layer.getFeature(fid)&#xd;&#xa;                                        )&#xd;&#xa;&#xd;&#xa;" shortTitle="Inverse la direction de l'entité" id="{0e10379d-c3a2-43be-a642-61b2bf9ea557}" type="1" notificationMessage="" isEnabledOnlyWhenEditable="1" name="reverse vertices" capture="0">
